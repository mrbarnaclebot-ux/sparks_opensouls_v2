{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ES2022",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["bun-types", "node", "@aws-lite/s3-types"],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "preserveSymlinks": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "noEmit": true,
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "tests", "examples"]
}
